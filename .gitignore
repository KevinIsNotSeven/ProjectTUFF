CharacterSkins/
sd_install/ultimate/mods/skins-*/
sd_install/ultimate/mods/skin-*/
*.zip
*.rar

# Build output (builds normally go to an outside CARGO_TARGET_DIR anyway)
target/
*.bak
*.bak-*

# Python
__pycache__/
*.pyc
